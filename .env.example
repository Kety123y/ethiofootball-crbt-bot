# EthioFootball CRBT Bot — Environment Variables
# Copy this to .env and fill in your values

# Required: Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Required: Your Telegram user ID(s) — comma-separated for multiple admins
# Get your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Optional: path to SQLite database (default: songs.db)
DB_PATH=songs.db

# Optional: rate limit in seconds per user (default: 3)
RATE_LIMIT_SECONDS=3
